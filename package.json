{
  "name": "daily-smile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run test:coverage && npm run build && npm run e2e",
    "worker:dev": "wrangler dev -c worker/wrangler.toml",
    "worker:deploy": "npm run build && wrangler deploy -c worker/wrangler.toml"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "4.140.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
